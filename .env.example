# agent-hub-remote local config example.
# Copy to .env and fill in your own values. The real .env is gitignored.
#
# Keep secrets such as TOTP_SECRET in your Windows user environment when
# possible. A local .env is acceptable for a private single-user install.

# === Local server ===
# Local HTTP port. AHR_PORT and AGENT_HUB_PORT are backward-compatible aliases.
AHR_HTTP_PORT=3334
# AHR_PORT=3334
# AGENT_HUB_PORT=3334

# Bind loopback by default. Setting 0.0.0.0 exposes AHR to your LAN; use only
# behind a trusted private network and with matching WebAuthn origin settings.
AHR_BIND_HOST=127.0.0.1

# Upload temp-file retention in milliseconds. Default: 24 hours; minimum: 60000.
# AHR_UPLOAD_TTL_MS=86400000

# === Local quickstart WebAuthn ===
# For passkeys on a local install, open http://localhost:3334, not 127.0.0.1.
# These are the built-in local defaults. Uncomment only if you need to pin or
# override them. If you change AHR_HTTP_PORT, update AHR_WEBAUTHN_ORIGIN.
# AHR_WEBAUTHN_RP_ID=localhost
# AHR_WEBAUTHN_ORIGIN=http://localhost:3334

# === Auth ===
# Required TOTP 32-character base32 value. Prefer setting this in the user
# environment rather than in this file.
# TOTP_SECRET=

# === Allowed project directories ===
# Prefer dirs.json for multiple projects. This env form is useful for small
# installs: ALLOWED_DIRS=alias:C:\path\one;other:C:\path\two
# ALLOWED_DIRS=home:C:\Users\<you>

# Limit native-session ingest to a comma-separated subset of allowed aliases.
# Leave unset to ingest all allowed directories.
# AHR_INGEST_ALIASES=home

# Reuse only a previously successful native-ingest result for this many ms.
# Manual UI refresh always bypasses this TTL. Default: 30000.
# AHR_SESSION_REFRESH_TTL_MS=30000

# Rediscover Claude project-directory mappings after this many ms. Manual UI
# refresh always bypasses this cache. Default: 30000.
# AHR_CLAUDE_DIR_CACHE_TTL_MS=30000

# Override native session roots when Claude Code or Codex use non-default paths.
# AHR_CLAUDE_PROJECTS_DIR=C:\Users\<you>\.claude\projects
# AHR_CODEX_SESSIONS_DIR=C:\Users\<you>\.codex\sessions

# Store AHR state outside the checkout. Default: .\.state
# AHR_STATE_DIR=C:\Users\<you>\AppData\Local\agent-hub-remote\state

# === Tailscale Serve settings ===
# Leave these commented for the local quickstart. When enabling Tailscale,
# uncomment and set all three, then switch WebAuthn origin to the HTTPS tailnet
# URL shown below.
# AHR_TAILNET_DOMAIN=your-tailnet.ts.net
# AHR_TAILNET_HOSTNAME=your-hostname
# AHR_TAILNET_IP=100.x.x.x
# AHR_TCP_PORT=3335
#
# AHR_WEBAUTHN_RP_ID=your-hostname.your-tailnet.ts.net
# AHR_WEBAUTHN_ORIGIN=https://your-hostname.your-tailnet.ts.net

# === Scheduled Task ===
AHR_TASK_NAME=AgentHubRemote

# === Usage display ===
# Optional local log overrides.
# AHR_CLAUDE_USAGE_LOG=C:\Users\<you>\.claude\usage-log.jsonl
# AHR_CODEX_USAGE_LOG=C:\Users\<you>\.codex\usage-log.jsonl

# Disable the optional Claude usage API poller. Keep this at 1 for a purely
# file-based usage display.
AHR_USAGE_API_DISABLE=1

# === Codex auto-commit helper ===
# AHR_CODEX_AUTO_COMMIT_DISABLE=1
# AHR_AUTO_COMMIT_DIFF_MAX=12000
# AHR_AUTO_COMMIT_NO_TRAILER=1
# AHR_AUTO_COMMIT_EDITOR=Co-Authored-By: Codex (agent-hub-remote) <codex@agent-hub-remote.local>

# === Logging ===
# AHR_ACCESS_LOG=1
